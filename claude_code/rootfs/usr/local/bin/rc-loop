#!/bin/bash
# Hält "claude remote-control" am Leben. Läuft im tmux-Fenster "remote".
cd /config || exit 1
while true; do
    echo "=== $(date '+%F %T') claude remote-control --name \"${RC_SESSION_NAME:-HAOS}\" ==="
    claude remote-control --name "${RC_SESSION_NAME:-HAOS}" || true
    echo
    echo "Remote Control beendet. Noch nicht eingeloggt?"
    echo "  -> im Fenster 'shell' (Ctrl-b 0) 'claude' starten und /login ausführen."
    echo "Neuer Versuch in 30 Sekunden ..."
    sleep 30
done
